---
import Layout from '../../layouts/Layout.astro';
import { blogs } from '../../data/blogs';
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---

<Layout title="Blogs - Binh Pham">
  <h1>Blogs</h1>
  <p>Projects, experiments, debugging notes, and things I learned while writing firmware.</p>

  {blogs.map(blog => (
    <section class="note-entry">
      <a href={baseUrl + blog.path}><h2>{blog.title}</h2></a>
      <p class="note-desc">{blog.description}</p>
      <div class="note-tags">{blog.tags.map(tag => <span>{tag}</span>)}</div>
    </section>
  ))}
</Layout>

<style>
  .note-entry {
    margin-bottom: 1.5rem;
  }

  .note-entry h2 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
    border: none;
    padding: 0;
  }

  .note-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 0.7rem;
  }

  .note-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .note-tags span {
    font: 400 0.67rem 'JetBrains Mono', monospace;
    padding: 0.17rem 0.48rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
    color: var(--text-muted);
  }
</style>
